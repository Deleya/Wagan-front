# Variables d'environnement pour le frontend WAGAN
# Copier ce fichier en .env

# L'URL de base de l'API Backend (Django) — NE PAS oublier le port !
# Par défaut, le backend Docker ou local écoute sur le port 8000.
# Préférer 'localhost' à '127.0.0.1' (origine enregistrée dans la Google Console pour l'OAuth).
# En production, mettre l'URL du backend déployé (ex: https://api.wagan.com)
VITE_API_URL=http://localhost:8000
